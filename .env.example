# Modello della configurazione: copialo in .env e compila i valori.
# Il file .env contiene segreti: non va mai su git (è già in .gitignore).
# Tieni una copia del tuo .env fuori dal progetto: se lo perdi, rimettilo da lì.
# (Con una SECRET_KEY nuova tutti gli utenti collegati devono rifare il login.)

# Ambiente: development (sviluppo) oppure demo (installazione della demo).
# I test usano da soli l'ambiente "testing": non serve impostarlo qui.
APP_ENV=development

# Chiave segreta che firma le sessioni: almeno 32 caratteri casuali, diversa su ogni PC.
# Generala con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Indirizzo e porta del server.
# 127.0.0.1 = raggiungibile solo da questo PC; 0.0.0.0 = anche dalla rete locale (demo, P39).
HOST=127.0.0.1
PORT=5000

# MySQL 8.0. L'utente del progetto lo crea scripts/setup_db.sql (P5);
# prima di P5 puoi mettere qui l'utente root per provare l'avvio.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cinquecento
DB_PASSWORD=
DB_NAME=cinquecento_dev
# Database dei test: deve finire con _test, altrimenti i test si rifiutano di partire.
DB_NAME_TEST=cinquecento_test

# Livello dei log: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO
